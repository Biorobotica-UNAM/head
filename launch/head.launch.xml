<launch>

  <arg name="use_sim_time" default="false"/>

  <group>
    <push-ros-namespace namespace="head"/>

    <node pkg="head" exec="head_node" name="head_node" output="screen">
      <param from="$(find-pkg-share head)/config/head.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

  </group>

</launch>
